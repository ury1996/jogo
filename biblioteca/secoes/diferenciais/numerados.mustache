<div class="rk-wrap">
  <div class="dif-topo">
    <div class="rk-cab dif-cab">
      <p class="rk-eyebrow" data-k="dif.eyebrow">{{c.dif.eyebrow}}</p>
      <h2 class="rk-h2 dif-titulo" data-k="dif.titulo">{{c.dif.titulo}}</h2>
    </div>
    <a class="rk-btn rk-btn--sec dif-btn" href="{{d.whatsappLink}}" data-ev="whatsapp" data-pos="diferenciais" target="_blank" rel="noopener"><span class="rk-i">{{{u.whatsapp}}}</span><span data-k="hero.cta">{{c.hero.cta}}</span></a>
  </div>
  <ol class="dif-cols" data-li="dif">
    {{#c.dif.itens}}
    <li class="dif-col" data-it="{{id}}">
      <span class="dif-col__n" aria-hidden="true">0{{i}}</span>
      <h3 class="rk-h3 dif-col__t" data-k="{{k}}.t">{{t}}</h3>
      <p class="rk-p dif-col__d" data-k="{{k}}.d">{{d}}</p>
    </li>
    {{/c.dif.itens}}
  </ol>
</div>
