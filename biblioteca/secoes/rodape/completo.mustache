<footer class="rod">
  <div class="rk-wrap rod-grade">
    <div class="rod-col rod-sobre">
      <a class="rk-logo" href="#topo">{{{d.logo.html}}}{{^d.logo.temLogo}}<span class="rk-logo__nome">{{d.nome}}</span>{{/d.logo.temLogo}}</a>
      <p class="rk-p rod-sobre__txt" data-k="rodape.sobre">{{c.rodape.sobre}}</p>
      {{#d.temRedes}}<ul class="rk-redes">{{#d.redes}}<li><a href="{{url}}" target="_blank" rel="noopener" aria-label="{{rotulo}}">{{{svg}}}</a></li>{{/d.redes}}</ul>{{/d.temRedes}}
    </div>
    <nav class="rod-col" aria-label="Navegação do rodapé">
      <p class="rod-tit">Navegação</p>
      <ul class="rod-links"><li><a href="#topo">Início</a></li>{{#menu}}<li><a href="{{href}}">{{rotulo}}</a></li>{{/menu}}</ul>
    </nav>
    <div class="rod-col">
      <p class="rod-tit" data-k="serv.eyebrow">{{c.serv.eyebrow}}</p>
      <ul class="rod-links" data-li="serv">{{#c.serv.itens}}<li data-it="{{id}}"><a href="#servicos" data-k="{{k}}.t">{{t}}</a></li>{{/c.serv.itens}}</ul>
    </div>
    <div class="rod-col">
      <p class="rod-tit">Contato</p>
      <ul class="rod-contatos">
        {{#d.temWhatsapp}}<li><span class="rk-i">{{{u.whatsapp}}}</span><a href="{{d.whatsappLink}}" data-ev="whatsapp" data-pos="rodape" target="_blank" rel="noopener">{{d.whatsapp}}</a></li>{{/d.temWhatsapp}}
        {{#d.temTelefone}}<li><span class="rk-i">{{{u.telefone}}}</span><a href="{{d.telefoneLink}}" data-ev="telefone">{{d.telefone}}</a></li>{{/d.temTelefone}}
        {{#d.temEmail}}<li><span class="rk-i">{{{u.email}}}</span><a href="{{d.emailLink}}">{{d.email}}</a></li>{{/d.temEmail}}
        {{#d.temEndereco}}<li><span class="rk-i">{{{u.pin}}}</span><a href="{{d.mapaLink}}" target="_blank" rel="noopener"><span class="rod-linhas">{{#d.enderecoLinhas}}<span>{{.}}</span>{{/d.enderecoLinhas}}</span></a></li>{{/d.temEndereco}}
        {{#d.temHorarios}}<li><span class="rk-i">{{{u.relogio}}}</span><span class="rod-linhas">{{#d.horarios}}<span>{{dias}}: {{horas}}</span>{{/d.horarios}}</span></li>{{/d.temHorarios}}
      </ul>
    </div>
  </div>
  <div class="rk-wrap rod-base">
    <p class="rod-base__id">© {{d.ano}} {{d.nome}}{{#d.temRegistro}}<span class="rod-sep" aria-hidden="true">·</span><span class="rod-registro">{{d.registro}}</span>{{/d.temRegistro}}</p>
    <p class="rod-base__links"><span data-k="rodape.texto">{{c.rodape.texto}}</span><span class="rod-sep" aria-hidden="true">·</span><a href="/privacidade/">Política de privacidade</a><span class="rod-sep" aria-hidden="true">·</span><a class="rod-topo" href="#topo">Voltar ao topo</a></p>
  </div>
</footer>
