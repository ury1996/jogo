<div class="rk-wrap hero-grade">
  <div class="hero-texto">
    <p class="rk-eyebrow" data-k="hero.eyebrow">{{c.hero.eyebrow}}</p>
    <h1 class="rk-h1 hero-titulo" data-k="hero.titulo">{{c.hero.titulo}}</h1>
    <p class="rk-lead hero-lead" data-k="hero.texto">{{c.hero.texto}}</p>
    <div class="rk-acoes hero-acoes">
      <a class="rk-btn" href="{{d.whatsappLink}}" data-ev="whatsapp" data-pos="hero" target="_blank" rel="noopener"><span class="rk-i">{{{u.whatsapp}}}</span><span data-k="hero.cta">{{c.hero.cta}}</span></a>
      <a class="rk-btn rk-btn--sec" href="#servicos"><span data-k="hero.cta2">{{c.hero.cta2}}</span></a>
    </div>
    <div class="hero-prova">
      <div class="rk-avatares" aria-hidden="true">
        {{#c.equipe.p1}}<span class="rk-avatar" data-img="{{k}}.f">{{{f.html}}}</span>{{/c.equipe.p1}}
        {{#c.equipe.p2}}<span class="rk-avatar" data-img="{{k}}.f">{{{f.html}}}</span>{{/c.equipe.p2}}
        {{#c.equipe.p3}}<span class="rk-avatar" data-img="{{k}}.f">{{{f.html}}}</span>{{/c.equipe.p3}}
        <span class="rk-avatar rk-avatar--cor">{{d.inicial}}</span>
      </div>
      {{#c.num.p2}}<p class="hero-prova__txt"><strong class="hero-prova__v" data-k="{{k}}.v">{{v}}</strong> <span class="hero-prova__l" data-k="{{k}}.l">{{l}}</span></p>{{/c.num.p2}}
    </div>
  </div>
  <div class="hero-midia">
    <div class="rk-foto rk-foto--deco hero-foto" data-img="hero.img" style="--ar:4/5">{{{c.hero.img.html}}}</div>
    <p class="rk-selo hero-selo"><span class="rk-check__ic">{{{u.check}}}</span><span class="hero-selo__txt" data-k="hero.selo">{{c.hero.selo}}</span></p>
    {{#c.num.p1}}<div class="rk-selo hero-num"><span class="rk-ic rk-ic--p">{{{u.estrela}}}</span><span><strong class="rk-selo__v" data-k="{{k}}.v">{{v}}</strong><span class="rk-selo__l" data-k="{{k}}.l">{{l}}</span></span></div>{{/c.num.p1}}
  </div>
</div>
