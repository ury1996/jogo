<div class="rk-wrap">
  <div class="rk-cab serv-cab">
    <p class="rk-eyebrow" data-k="serv.eyebrow">{{c.serv.eyebrow}}</p>
    <h2 class="rk-h2 serv-titulo" data-k="serv.titulo">{{c.serv.titulo}}</h2>
    <p class="rk-lead serv-lead" data-k="serv.texto">{{c.serv.texto}}</p>
  </div>
  <div class="serv-grade serv-q{{c.serv.qtd}}" data-li="serv">
    {{#c.serv.itens}}
    <article class="rk-card serv-card" data-it="{{id}}">
      <span class="rk-ic" data-ic="{{k}}">{{{ic.svg}}}</span>
      <h3 class="rk-h3 serv-card__t" data-k="{{k}}.t">{{t}}</h3>
      <p class="rk-p serv-card__d" data-k="{{k}}.d">{{d}}</p>
      <a class="rk-link serv-card__link" href="{{dados.whatsappLink}}" data-ev="whatsapp" data-pos="servicos" target="_blank" rel="noopener"><span data-k="serv.link">{{c.serv.link}}</span><span class="rk-sr"> – {{t}}</span><span class="rk-i">{{{u.seta}}}</span></a>
    </article>
    {{/c.serv.itens}}
  </div>
</div>
