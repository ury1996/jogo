<div class="rk-wrap">
  <div class="serv-topo">
    <div class="rk-cab serv-cab">
      <p class="rk-eyebrow" data-k="serv.eyebrow">{{c.serv.eyebrow}}</p>
      <h2 class="rk-h2 serv-titulo" data-k="serv.titulo">{{c.serv.titulo}}</h2>
    </div>
    <p class="rk-lead serv-lead" data-k="serv.texto">{{c.serv.texto}}</p>
  </div>
  <div class="serv-grade serv-q{{c.serv.qtd}}" data-li="serv">
    {{#c.serv.itens}}
    <article class="serv-sob" data-it="{{id}}">
      <div class="rk-foto serv-sob__foto" data-img="{{k}}.img" style="--ar:4/3">{{{img.html}}}</div>
      <div class="rk-card rk-card--estatico serv-sob__card">
        <span class="rk-ic rk-ic--p serv-sob__ic" data-ic="{{k}}">{{{ic.svg}}}</span>
        <h3 class="rk-h3 serv-sob__t" data-k="{{k}}.t">{{t}}</h3>
        <p class="rk-p serv-sob__d" data-k="{{k}}.d">{{d}}</p>
        <a class="rk-link serv-sob__link" href="{{dados.whatsappLink}}" data-ev="whatsapp" data-pos="servicos" target="_blank" rel="noopener"><span data-k="serv.link">{{c.serv.link}}</span><span class="rk-sr"> – {{t}}</span><span class="rk-i">{{{u.seta}}}</span></a>
      </div>
    </article>
    {{/c.serv.itens}}
  </div>
</div>
