<div class="rk-wrap">
  <div class="serv-topo">
    <div class="rk-cab serv-cab">
      <p class="rk-eyebrow" data-k="serv.eyebrow">{{c.serv.eyebrow}}</p>
      <h2 class="rk-h2 serv-titulo" data-k="serv.titulo">{{c.serv.titulo}}</h2>
    </div>
    <div class="serv-topo__lado">
      <p class="rk-lead serv-lead" data-k="serv.texto">{{c.serv.texto}}</p>
      <a class="rk-btn serv-btn" href="{{d.whatsappLink}}" data-ev="whatsapp" data-pos="servicos" target="_blank" rel="noopener"><span class="rk-i">{{{u.whatsapp}}}</span><span data-k="hero.cta">{{c.hero.cta}}</span></a>
    </div>
  </div>
  <ol class="serv-num" data-li="serv">
    {{#c.serv.itens}}
    <li class="serv-nl" data-it="{{id}}">
      <span class="serv-nl__n" aria-hidden="true">0{{i}}</span>
      <h3 class="rk-h3 serv-nl__t" data-k="{{k}}.t">{{t}}</h3>
      <p class="rk-p serv-nl__d" data-k="{{k}}.d">{{d}}</p>
      <a class="serv-nl__seta" href="{{dados.whatsappLink}}" data-ev="whatsapp" data-pos="servicos" target="_blank" rel="noopener"><span class="rk-sr">{{c.serv.link}} – {{t}}</span><span class="rk-i">{{{u.seta}}}</span></a>
    </li>
    {{/c.serv.itens}}
  </ol>
</div>
