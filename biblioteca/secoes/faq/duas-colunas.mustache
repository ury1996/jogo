<div class="rk-wrap">
  <div class="rk-cab rk-cab--centro faq-cab">
    <p class="rk-eyebrow" data-k="faq.eyebrow">{{c.faq.eyebrow}}</p>
    <h2 class="rk-h2 faq-titulo" data-k="faq.titulo">{{c.faq.titulo}}</h2>
    <p class="rk-lead faq-lead" data-k="faq.texto">{{c.faq.texto}}</p>
  </div>
  <div class="faq-lista faq-colunas" data-li="faq">
    {{#c.faq.itens}}
    <details class="faq-item" data-it="{{id}}"{{#primeiro}} open{{/primeiro}}>
      <summary class="faq-q">
        <span class="faq-num" aria-hidden="true"></span>
        <h3 class="faq-q__t" data-k="{{k}}.q">{{q}}</h3>
        <span class="faq-q__ic" aria-hidden="true"><span class="faq-mais">{{{u.mais}}}</span><span class="faq-menos">{{{u.menos}}}</span></span>
      </summary>
      <div class="faq-a">
        <p class="rk-p" data-k="{{k}}.a">{{a}}</p>
      </div>
    </details>
    {{/c.faq.itens}}
  </div>
  <div class="faq-rodape">
    <p class="faq-rodape__txt" data-k="faq.ajuda">{{c.faq.ajuda}}</p>
    {{#d.temWhatsapp}}
    <a class="rk-btn rk-btn--sec faq-rodape__btn" href="{{d.whatsappLink}}" data-ev="whatsapp" data-pos="faq" target="_blank" rel="noopener"><span class="rk-i">{{{u.whatsapp}}}</span><span>Chamar no WhatsApp</span></a>
    {{/d.temWhatsapp}}
  </div>
</div>
