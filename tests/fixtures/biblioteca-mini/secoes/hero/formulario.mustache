<div class="rk-wrap hero-grade hero-grade--form">
  <div class="hero-texto">
    <p class="rk-eyebrow" data-k="hero.eyebrow">{{c.hero.eyebrow}}</p>
    <h1 class="rk-h1" data-k="hero.titulo">{{c.hero.titulo}}</h1>
    <p class="rk-lead" data-k="hero.texto">{{c.hero.texto}}</p>
    {{#c.serv.tem}}
    <ul class="hero-lista" data-li="serv">
      {{#c.serv.itens}}
      <li data-it="{{id}}">{{{u.check}}}<span data-k="{{k}}.t">{{t}}</span></li>
      {{/c.serv.itens}}
    </ul>
    {{/c.serv.tem}}
  </div>
  <div class="rk-card hero-form">
    <h2 class="rk-h3" data-k="form.titulo">{{c.form.titulo}}</h2>
    {{> formulario}}
    <p class="rk-small" data-k="form.nota">{{c.form.nota}}</p>
  </div>
</div>
