{
  "name": "Construtor Rankly (modo demonstração)",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "composer install --no-interaction --no-progress",
  "postStartCommand": "bash -c 'mkdir -p var && nohup bin/demo.sh > var/demo.log 2>&1 &'",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Construtor Rankly", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Opcional: chave da IA (https://aistudio.google.com/apikey). Sem ela, a IA funciona em modo simulado."
    }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/DEMONSTRACAO.md"] }
  }
}
